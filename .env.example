DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/poker_dev"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="24h"
PORT=3000

# 0.0.0.0 expõe o servidor para a rede local (necessário para testar no celular).
# Use 127.0.0.1 para restringir a esta máquina.
HOST=0.0.0.0

# Vazio = libera origens da rede local (localhost, 192.168.x, 10.x, Tailscale).
# Em produção, defina os domínios exatos: CORS_ORIGIN="https://seujogo.com"
CORS_ORIGIN=

# Vazio = o cliente usa o mesmo host da página, na porta 3000.
# Preencha apenas se o backend ficar num domínio diferente do cliente.
VITE_API_URL=
VITE_SOCKET_URL=
